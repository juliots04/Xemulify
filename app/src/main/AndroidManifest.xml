<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Para listar y lanzar apps instaladas (accesos directos) en Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <!-- El mando/teclado es opcional; también funciona con el mando de la TV. -->
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xemulify">
        <activity
            android:name=".MainActivity"
            android:banner="@drawable/banner_tv"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".emulator.GameActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation|keyboard"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Xemulify" />

        <activity
            android:name=".settings.ControlsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Xemulify" />

        <activity
            android:name=".settings.GeneralSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Xemulify" />

        <activity
            android:name=".cheats.CheatConfigActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Xemulify" />

        <activity
            android:name=".settings.TouchEditorActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Xemulify" />

        <!-- Servicio de accesibilidad del mapeador táctil (se activa a mano en Ajustes de Android). -->
        <service
            android:name=".input.TouchMapperService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/touch_mapper_service" />
        </service>
    </application>

</manifest>
