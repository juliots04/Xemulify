<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_key_row"
    android:layout_marginBottom="12dp"
    android:paddingTop="13dp"
    android:paddingBottom="13dp"
    android:paddingStart="18dp"
    android:paddingEnd="12dp">

    <!-- Icono + nombre del botón -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/img_button_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="14dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/txt_button_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Columna teclado -->
    <Button
        android:id="@+id/btn_map_keyboard"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_key_mapping_btn"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        android:focusable="true" />

    <!-- Columna mando -->
    <Button
        android:id="@+id/btn_map_gamepad"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_key_mapping_btn"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        android:focusable="true" />
</LinearLayout>
