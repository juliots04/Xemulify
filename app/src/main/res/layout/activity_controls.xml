<?xml version="1.0" encoding="utf-8"?>
<!-- Conf. controles: el título se desplaza con el scroll; SOLO la cabecera de columnas
     (Player 1 / Player 2 / Mando) queda fija arriba (copia header_pinned que aparece al scrollear). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:paddingLeft="56dp"
    android:paddingRight="56dp">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingTop="40dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_section_panel"
            android:paddingTop="22dp"
            android:paddingBottom="24dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">

            <!-- Título (se desplaza) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="22dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_header_icon"
                    android:padding="12dp"
                    android:src="@drawable/ic_action_keys"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/controls_title"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.01" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/controls_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cabecera de columnas real (se desplaza; su copia fija la reemplaza) -->
            <LinearLayout
                android:id="@+id/header_real"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:paddingTop="6dp"
                android:paddingBottom="10dp">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1.2" android:text="@string/touch_col_button"
                    android:textColor="@color/accent" android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" android:textAllCaps="true" android:letterSpacing="0.08" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/controls_p1"
                    android:textColor="@color/text_muted" android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" android:textAllCaps="true" android:letterSpacing="0.08" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/controls_p2"
                    android:textColor="@color/text_muted" android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" android:textAllCaps="true" android:letterSpacing="0.08" android:gravity="center" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/controls_col_gamepad"
                    android:textColor="@color/text_muted" android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" android:textAllCaps="true" android:letterSpacing="0.08" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ps1_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Atajos del emulador -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keys_hotkeys_header"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="0dp" />

            <LinearLayout
                android:id="@+id/hotkeys_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_text_focus"
                android:text="@string/keys_reset"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:paddingLeft="16dp" android:paddingRight="16dp"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:focusable="true" />

            <!-- Divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="18dp"
                android:background="@color/stroke_subtle" />

            <!-- Mapeo táctil (incluido al final) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/touch_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="@string/touch_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/touch_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btn_touch_add"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/bg_text_focus" android:text="@string/touch_add"
                    android:textColor="@color/accent" android:textSize="14sp" android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    android:paddingLeft="16dp" android:paddingRight="16dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp" android:focusable="true" />

                <Button
                    android:id="@+id/btn_touch_positions"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_text_focus" android:text="@string/touch_edit_positions"
                    android:textColor="@color/text_primary" android:textSize="14sp" android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    android:paddingLeft="16dp" android:paddingRight="16dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp" android:focusable="true" />

                <Button
                    android:id="@+id/btn_touch_overlay"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_text_focus"
                    android:textColor="@color/text_primary" android:textSize="14sp" android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    android:paddingLeft="16dp" android:paddingRight="16dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp" android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Copia FIJA de la cabecera (se muestra al hacer scroll) -->
    <LinearLayout
        android:id="@+id/header_pinned"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface_1"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1.2" android:text="@string/touch_col_button"
            android:textColor="@color/accent" android:textSize="12sp"
            android:fontFamily="sans-serif-medium" android:textAllCaps="true" android:letterSpacing="0.08" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/controls_p1"
            android:textColor="@color/text_muted" android:textSize="12sp"
            android:fontFamily="sans-serif-medium" android:textAllCaps="true" android:letterSpacing="0.08" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/controls_p2"
            android:textColor="@color/text_muted" android:textSize="12sp"
            android:fontFamily="sans-serif-medium" android:textAllCaps="true" android:letterSpacing="0.08" android:gravity="center" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/controls_col_gamepad"
            android:textColor="@color/text_muted" android:textSize="12sp"
            android:fontFamily="sans-serif-medium" android:textAllCaps="true" android:letterSpacing="0.08" android:gravity="center" />
    </LinearLayout>
</FrameLayout>
