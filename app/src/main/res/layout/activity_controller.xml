<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/controller_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B10"
    android:keepScreenOn="true">

    <!-- Vista del Mando Virtual PlayStation (Pantalla completa inmersiva) -->
    <com.example.xemulify.controller.VirtualGamepadView
        android:id="@+id/virtual_gamepad"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barra de estado HUD flotante centrada (Cero conflicto con L1/L2 y R1/R2) -->
    <LinearLayout
        android:id="@+id/hud_top_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_glass_hud_capsule"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:elevation="6dp">

        <!-- Badge de Jugador -->
        <TextView
            android:id="@+id/txt_player_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P1"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_player_chip"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/txt_host_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Xemulify TV"
            android:textColor="#E2E4F0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#33FFFFFF" />

        <!-- Latencia Ping en tiempo real (Icono Wi-Fi pequeño y texto perfectamente centrado) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_wifi_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_wifi_signal"
                android:contentDescription="WiFi" />

            <TextView
                android:id="@+id/txt_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="1 ms"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>

    <!-- Selector sutil de tema (Desglosable justo debajo de Xemulify en el centro) -->
    <TextView
        android:id="@+id/btn_theme_dropdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="135dp"
        android:background="@drawable/bg_subtle_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:text="tema: negro amoled ▾"
        android:textColor="#55FFFFFF"
        android:textSize="10sp"
        android:letterSpacing="0.04"
        android:fontFamily="sans-serif-medium" />

</FrameLayout>
