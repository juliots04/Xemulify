<?xml version="1.0" encoding="utf-8"?>
<!-- Config del servicio de accesibilidad del mapeador táctil.
     canRequestFilterKeyEvents + flagRequestFilterKeyEvents = par obligatorio para recibir
     teclas (onKeyEvent). canPerformGestures = para inyectar toques. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="0"
    android:canRequestFilterKeyEvents="true"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="false"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagDefault"
    android:description="@string/touch_service_desc" />
