<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema principal AMOLED para Android TV -->
    <style name="Theme.Xemulify" parent="@style/Theme.Leanback">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:colorBackground">@color/amoled_black</item>
        <item name="android:navigationBarColor">@color/amoled_black</item>
        <item name="android:statusBarColor">@color/amoled_black</item>
    </style>

    <!-- Diálogos en modo oscuro (framework Material) -->
    <style name="Theme.Xemulify.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlActivated">@color/accent</item>
    </style>

    <!-- Diálogo pantalla completa sin bordes ni márgenes -->
    <style name="Theme.Xemulify.FullscreenDialog" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#15151C</item>
        <item name="android:colorBackground">#15151C</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:statusBarColor">#15151C</item>
        <item name="android:navigationBarColor">#15151C</item>
    </style>
</resources>
