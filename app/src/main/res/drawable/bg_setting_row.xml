<?xml version="1.0" encoding="utf-8"?>
<!-- Igual que bg_key_row: fila plana con realce solo al enfocar. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_focus_top" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_focus_top" />
            <stroke android:width="2dp" android:color="@color/accent_dim" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
