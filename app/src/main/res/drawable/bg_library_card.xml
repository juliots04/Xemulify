<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Enfocado en Android TV: borde de acento -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Normal: card AMOLED minimalista -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_1" />
            <stroke android:width="1dp" android:color="@color/stroke_subtle" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
