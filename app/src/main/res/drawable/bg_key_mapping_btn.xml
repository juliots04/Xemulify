<?xml version="1.0" encoding="utf-8"?>
<!-- Chip de control: píldora plana y uniforme (una por columna, mismo tamaño). Sin relieve.
     Foco = wash violeta + borde de acento; "escuchando" = accent_soft. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Esperando la tecla -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_soft" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- Enfocado -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_focus_top" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- Pulsado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_soft" />
            <stroke android:width="2dp" android:color="@color/accent_dim" />
            <corners android:radius="100dp" />
        </shape>
    </item>

    <!-- Normal: píldora plana tonal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#262A33" />
            <stroke android:width="1dp" android:color="@color/card_stroke" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
