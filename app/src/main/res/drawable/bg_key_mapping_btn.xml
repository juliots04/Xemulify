<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Esperando la tecla a asignar -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_soft" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Enfocado con mando/D-pad -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_3" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Pulsado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_soft" />
            <stroke android:width="1.5dp" android:color="@color/accent_dim" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <stroke android:width="1dp" android:color="@color/stroke_subtle" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
