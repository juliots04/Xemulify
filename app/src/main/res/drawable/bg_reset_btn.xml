<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Enfocado: se realza sutilmente, sin gritar -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/danger_soft" />
            <stroke android:width="1.5dp" android:color="@color/danger" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/danger_soft" />
            <stroke android:width="1.5dp" android:color="@color/danger" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Normal: ghost — solo un borde tenue -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="@color/stroke_strong" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
