<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Enfocado (TV / Mando) - Solo fondo iluminado, sin borde morado -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2D313E"
                android:endColor="#222530" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#353A4B" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Normal por defecto - Sin borde -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#181920"
                android:endColor="#121318" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
