<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="115"
                android:startColor="#2A2440"
                android:endColor="#1A1730" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#241F38" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="115"
                android:startColor="#181820"
                android:endColor="#121218" />
            <stroke android:width="1dp" android:color="#26262F" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
