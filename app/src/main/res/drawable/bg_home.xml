<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base diagonal gradient (charcoal → deep indigo-black) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="120"
                android:startColor="#1A1626"
                android:centerColor="#101019"
                android:endColor="#08080C" />
        </shape>
    </item>
    <!-- Soft accent glow, top-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.18"
                android:centerY="0.0"
                android:gradientRadius="620"
                android:startColor="#3D7C5CFF"
                android:endColor="#007C5CFF" />
        </shape>
    </item>
    <!-- Soft pink glow, far right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="0.15"
                android:gradientRadius="520"
                android:startColor="#22F472B6"
                android:endColor="#00F472B6" />
        </shape>
    </item>
</layer-list>
